@page "/"
@using HeatDiffusion1D.Solver
@using ScottPlot.Blazor
@rendermode InteractiveServer

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; max-width: 800px; margin-bottom: 1rem; font-family: sans-serif; font-size: 0.9rem;">
    <label>Nodes (Array Size): <br /><input type="number" @bind="nodes" min="3" max="500" disabled="@IsPlaying" /></label>
    <label>Rod Length (m): <br /><input type="number" @bind="rodLength" step="0.1" /></label>
    <label>Conductivity (W/m·K): <br /><input type="number" @bind="conductivity" step="10" /></label>
    <label>Density (kg/m³): <br /><input type="number" @bind="density" step="100" /></label>
    <label>Specific Heat (J/kg·K): <br /><input type="number" @bind="specificHeat" step="50" /></label>
    <label>Time Step dt (s): <br /><input type="number" @bind="dt" step="0.01" /></label>
    <label>Steps/Frame: <br /><input type="number" @bind="stepsPerFrame" min="1" /></label>
</div>

<div style="margin-bottom: 1rem;">
    <button @onclick="TogglePlay">@(IsPlaying ? "Stop" : "Play")</button>
    <button @onclick="ResetSimulation" disabled="@IsPlaying">Reset</button>
</div>

<div style="font-family: monospace; margin-bottom: 0.5rem; display: flex; gap: 2rem; flex-wrap: wrap;">
    <span>Tempo: @currentTime.ToString("F2") s</span>
    <span style="color: @(CFL > 0.5 ? "red" : "green"); font-weight: bold;">
        CFL (r): @CFL.ToString("F3") @(CFL > 0.5 ? " (Instável!)" : " (Estável)")
    </span>
    <span style="color: #0078D7; font-weight: bold;">
        Temp. Meio: @(GetCenterTemperature().ToString("F2")) °C
    </span>
</div>

<!-- Representação da barra 1D -->
<div style="display: flex; width: 100%; height: 50px; border: 1px solid #333; margin-bottom: 1rem;">
    @for (int i = 0; i < T.Length; i++)
    {
        var fraction = Math.Clamp(T[i] / 100.0, 0, 1);
        var r = (int)(255 * fraction);
        var b = (int)(255 * (1 - fraction));

        <div style="flex: 1; background-color: rgb(@r, 0, @b); height: 100%;"></div>
    }
</div>

<!-- Gráfico do Mid Point (Renderizado no Servidor via Base64) -->
<div style="width: 100%; height: 350px; text-align: center; margin-bottom: 1rem;">
    @if (!string.IsNullOrEmpty(plotImageSource))
    {
        <img src="@plotImageSource" style="max-width: 100%; height: 100%; object-fit: contain;" />
    }
</div>

@code {
    private bool IsPlaying = false;
    private double currentTime = 0;
    private double[] T = Array.Empty<double>();
    private double[] TBuffer = Array.Empty<double>();

    // Variáveis para o Gráfico
    private string plotImageSource = "";
    private ScottPlot.Plot myPlot = new();
    private ScottPlot.Plottables.DataLogger midPointLogger;

    private int nodes = 50;
    private double rodLength = 1.0;
    private double conductivity = 45.0;
    private double density = 7800.0;
    private double specificHeat = 470.0;
    private double dt = 0.5;
    private int stepsPerFrame = 10;

    private double Alpha => conductivity / (density * specificHeat);
    private double Dx => rodLength / nodes;
    private double CFL => Alpha * dt / (Dx * Dx);

    protected override void OnInitialized()
    {
        // Configuração inicial do gráfico
        midPointLogger = myPlot.Add.DataLogger();
        midPointLogger.Color = new ScottPlot.Color(0, 120, 215);

        myPlot.Title("Evolução da Temperatura no Centro da Barra");
        myPlot.XLabel("Tempo (s)");
        myPlot.YLabel("Temperatura (°C)");

        ResetSimulationState();
        UpdatePlotImage();
    }

    private void ResetSimulation()
    {
        ResetSimulationState();

        midPointLogger.Clear();
        midPointLogger.Add(currentTime, GetCenterTemperature());
        myPlot.Axes.AutoScale();
        UpdatePlotImage();
    }

    private void ResetSimulationState()
    {
        T = new double[nodes];
        TBuffer = new double[nodes];
        currentTime = 0;

        Array.Fill(T, 0);
        T[0] = 100;
    }

    private void UpdatePlotImage()
    {
        // Gera a imagem no servidor e converte para Base64
        byte[] imageBytes = myPlot.GetImageBytes(600, 350, ScottPlot.ImageFormat.Png);
        plotImageSource = $"data:image/png;base64,{Convert.ToBase64String(imageBytes)}";
    }

    private async Task TogglePlay()
    {
        IsPlaying = !IsPlaying;

        while (IsPlaying)
        {
            if (CFL > 0.5)
            {
                IsPlaying = false;
                break;
            }

            HeatSolver.Evolve(T, TBuffer, Alpha, Dx, dt, stepsPerFrame);
            currentTime += dt * stepsPerFrame;

            // Adiciona o novo ponto
            midPointLogger.Add(currentTime, GetCenterTemperature());

            // Atualiza a imagem convertida
            UpdatePlotImage();

            StateHasChanged();

            // Aumentei ligeiramente o atraso para dar folga ao servidor
            // devido à conversão para Base64 a cada frame
            await Task.Delay(30);
        }
    }

    private double GetCenterTemperature()
    {
        if (T.Length == 0) return 0;

        int mid = T.Length / 2;

        if (T.Length % 2 == 0)
        {
            return (T[mid - 1] + T[mid]) / 2.0;
        }

        return T[mid];
    }
}